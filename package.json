{
  "name": "ravenshop",
  "version": "1.0.0",
  "private": true,
  "description": "RavenShop landing page. Tailwind is compiled locally and assets/styles.css is committed, so GitHub Pages can serve it as-is.",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ./assets/styles.css --minify && node tools/stamp.mjs",
    "watch": "tailwindcss -i ./input.css -o ./assets/styles.css --watch",
    "images": "node tools/images.mjs"
  },
  "devDependencies": {
    "sharp": "0.34.2",
    "tailwindcss": "3.4.17"
  }
}
